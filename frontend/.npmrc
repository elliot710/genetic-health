# Block all install-time scripts by default (security hardening).
# Only explicitly listed packages are allowed to run build scripts.
# This prevents supply-chain attacks via malicious postinstall scripts.
ignore-scripts=true

# Explicitly allow packages that need native binary downloads:
#   sharp     — Next.js image optimisation (downloads libvips bindings)
#   unrs-resolver — Rust-based ESLint resolver (downloads napi binary)
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver
